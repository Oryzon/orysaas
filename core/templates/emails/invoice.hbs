{{#> layout}}
<p>Bonjour <strong>{{firstname}}</strong>,</p>

<p>Voici le reçu de votre dernier paiement pour <strong>{{organizationName}}</strong>.</p>

<table class="table">
    <tr>
        <td class="label">Facture</td>
        <td class="value">{{invoiceNumber}}</td>
    </tr>
    <tr>
        <td class="label">Date</td>
        <td class="value">{{date}}</td>
    </tr>
    <tr>
        <td class="label">Plan</td>
        <td class="value">{{planTitle}}</td>
    </tr>
    <tr class="total">
        <td class="label">Total payé</td>
        <td class="value">{{amount}}</td>
    </tr>
</table>

<a href="{{hostedInvoiceUrl}}" class="btn">Voir la facture</a>

<p>Vous pouvez retrouver l'historique complet de vos factures depuis votre espace de gestion d'abonnement.</p>
{{/layout}}