{
    "name": "orysaas",
    "author": "OryScorp and Ugo Bretbeil",
    "private": true,
    "workspaces": [
        "core",
        "webapp",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm:dev:*\"",
        "dev:core": "npm --workspace core run dev",
        "dev:webapp": "npm --workspace webapp run dev",
        "build": "npm --workspace core run build && npm --workspace webapp run build",
        "lint": "npm --workspace core run lint && npm --workspace webapp run lint",
        "seed": "npm --workspace core run seed --",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/run-tests.js",
        "test:watch": "npm --workspace core run test:watch",
        "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
        "test:db:down": "docker compose -f docker-compose.test.yml down"
    },
    "devDependencies": {
        "concurrently": "^9.0.0",
        "prettier": "^3.9.7",
        "typescript": "^5.0.0"
    }
}
